OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test-public.pem
OAUTH_PASSPHRASE=test-passphrase
OAUTH_ENCRYPTION_KEY=test-encryption-key-not-a-secret-0123456789
