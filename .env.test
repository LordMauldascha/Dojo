# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
API_KEY_ENCRYPTION_KEY=dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHQ=
# Test-only OAuth keys: separate files from dev, generated with `php bin/console league:oauth2-server:generate-keypair --env=test`
