{# A button that sends a POST request protected by a CSRF token (the token id must match the controller attribute). #}
{% macro post(action, tokenId, label, class = null) %}
    <form method="post" action="{{ action }}">
        <input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">
        <button type="submit"{% if class %} class="{{ class }}"{% endif %}>{{ label }}</button>
    </form>
{% endmacro %}

{# A button that opens a modal; the POST (CSRF token id must match the controller attribute) is sent only after the user confirms. Danger styled unless class says otherwise. #}
{% macro confirm_post(action, tokenId, label, title, message, confirmLabel = null, class = 'button-danger', triggerLabel = null, triggerClass = null) %}
    {% set id = 'confirm-' ~ tokenId %}
    <button type="button" class="{{ triggerClass ?? class }}" command="show-modal" commandfor="{{ id }}"{% if triggerLabel %} aria-label="{{ label }}" title="{{ label }}"{% endif %}>{{ triggerLabel ?? label }}</button>
    <dialog id="{{ id }}" aria-labelledby="{{ id }}-title" closedby="any">
        <h2 id="{{ id }}-title">{{ title }}</h2>
        <p>{{ message }}</p>
        <form method="post" action="{{ action }}">
            <input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">
            <button type="button" command="close" commandfor="{{ id }}" autofocus>Cancel</button>
            <button type="submit" class="{{ class }}">{{ confirmLabel ?? label }}</button>
        </form>
    </dialog>
{% endmacro %}
