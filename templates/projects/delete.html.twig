{% extends 'base.html.twig' %}

{% block title %}Delete project{% endblock %}

{% block body %}
    <h1>Delete project {{ project.title }}</h1>
    {{ include('_nav.html.twig') }}
    {{ include('_flashes.html.twig') }}

    <p>The project and its assignments to {{ project.groups|length }} group(s) and {{ project.users|length }} user(s) are deleted. The groups and users themselves are kept.</p>

    <form method="post" action="{{ path('app_project_delete', {uuid: project.uuid}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-project-' ~ project.uuid) }}">
        <button type="submit">Delete permanently</button>
    </form>
    <p><a href="{{ path('app_project_show', {uuid: project.uuid}) }}">Cancel</a></p>
{% endblock %}
