{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}Project {{ project.title }}{% endblock %}

{% block heading %}Project {{ project.title }}{% endblock %}

{% block content %}
    <p><a href="{{ path('app_projects') }}">Back to overview</a></p>

    {% if canManage %}
        <h2>Details</h2>
        {{ form(form) }}

        <h2>Groups</h2>
        {% if project.groups|length %}
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for group in project.groups %}
                        <tr>
                            <td>{{ group.title }}</td>
                            <td>
                                {{ forms.post(path('app_project_group_remove', {uuid: project.uuid, groupUuid: group.uuid}), 'remove-project-group-' ~ project.uuid ~ '-' ~ group.uuid, 'Remove') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>No groups assigned.</p>
        {% endif %}
        {{ form(addGroupForm) }}

        <h2>Users</h2>
        {% if project.users|length %}
            <table>
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in project.users %}
                        <tr>
                            <td>{{ user.username }}</td>
                            <td>{{ user.role.label }}</td>
                            <td>
                                {{ forms.post(path('app_project_user_remove', {uuid: project.uuid, userId: user.id}), 'remove-project-user-' ~ project.uuid ~ '-' ~ user.id, 'Remove') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>No users assigned.</p>
        {% endif %}
        {{ form(addUserForm) }}

        <h2>Skills</h2>
        {% if skills %}
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for skill in skills %}
                        <tr>
                            <td><a href="{{ path('app_skill_show', {uuid: skill.uuid}) }}">{{ skill.activeVersion.title }}</a></td>
                            <td>
                                {{ forms.post(path('app_project_skill_remove', {uuid: project.uuid, skillUuid: skill.uuid}), 'remove-project-skill-' ~ project.uuid ~ '-' ~ skill.uuid, 'Remove') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>No skills assigned.</p>
        {% endif %}
        {{ form(addSkillForm) }}
        <p><a href="{{ path('app_skills', {project: project.uuid}) }}">Open in skill overview</a></p>

        <h2>Testcases</h2>
        <p>Testcases: {{ testcaseCount }} (<a href="{{ path('app_testcases', {project: project.uuid}) }}">open in testcase overview</a>)</p>

        <h2>Runs</h2>
        <p>Runs: {{ runCount }} (<a href="{{ path('app_runs', {uuid: project.uuid}) }}">open runs</a>)</p>

        <h2>Delete project</h2>
        <p><a href="{{ path('app_project_delete', {uuid: project.uuid}) }}">Delete</a></p>
    {% else %}
        <h2>Description</h2>
        <p>{{ project.description ?? 'No description.' }}</p>

        <h2>Access</h2>
        <p>Groups: {{ project.groups|length }}</p>
        <p>Users: {{ project.users|length }}</p>
        <p>Skills: {{ skills|length }} (<a href="{{ path('app_skills', {project: project.uuid}) }}">open in skill overview</a>)</p>
        <p>Testcases: {{ testcaseCount }} (<a href="{{ path('app_testcases', {project: project.uuid}) }}">open in testcase overview</a>)</p>
        <p>Runs: {{ runCount }} (<a href="{{ path('app_runs', {uuid: project.uuid}) }}">open runs</a>)</p>
    {% endif %}
{% endblock %}
