{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}Project {{ storedTitle }}{% endblock %}

{% block heading %}Project {{ storedTitle }}{% endblock %}

{% block content %}
    {{ include('_back_link.html.twig', {href: path('app_projects'), label: 'Back to overview'}) }}

    <dl class="stats">
        <div class="stat stat--wide">
            <dt>Runs</dt>
            <dd>
                <a href="{{ path('app_runs', {uuid: project.uuid}) }}">{{ runCount }}</a>
                <a class="button button-primary" href="{{ path('app_run_new', {uuid: project.uuid}) }}">New run</a>
            </dd>
        </div>
        <div class="stat">
            <dt>Skills</dt>
            <dd><a href="{{ path('app_skills', {project: project.uuid}) }}">{{ skillCount }}</a></dd>
        </div>
        <div class="stat">
            <dt>Testcases</dt>
            <dd><a href="{{ path('app_testcases', {project: project.uuid}) }}">{{ testcaseCount }}</a></dd>
        </div>
    </dl>

    {% if canManage %}
        <h2>Details</h2>
        {{ form(form) }}

        <div class="split">
            <section>
                <h2>Groups</h2>
                <p class="help-text">Members of these groups can access this project.</p>
                {% if project.groups|length %}
                    <table>
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for group in project.groups %}
                                <tr>
                                    <td>{{ group.title }}</td>
                                    <td>
                                        {{ forms.post(path('app_project_group_remove', {uuid: project.uuid, groupUuid: group.uuid}), constant('App\\Controller\\ProjectController::CSRF_REMOVE_GROUP') ~ project.uuid ~ '-' ~ group.uuid, 'Remove') }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>No groups assigned.</p>
                {% endif %}
                {{ form(addGroupForm, {attr: {class: 'form-inline'}}) }}
            </section>

            <section>
                <h2>Users</h2>
                <p class="help-text">These users have direct access to this project.</p>
                {{ include('_members.html.twig', {users: project.users, owner: project, removeRoute: 'app_project_user_remove', removeTokenPrefix: constant('App\\Controller\\ProjectController::CSRF_REMOVE_USER'), emptyText: 'No users assigned.'}) }}
                {{ form(addUserForm, {attr: {class: 'form-inline'}}) }}
            </section>
        </div>

        <h2>Delete project</h2>
        {{ forms.confirm_post(path('app_project_delete', {uuid: project.uuid}), constant('App\\Controller\\ProjectController::CSRF_DELETE') ~ project.uuid, 'Delete', 'Delete project?', 'The project and its assignments to ' ~ project.groups|length ~ ' group(s) and ' ~ project.users|length ~ ' user(s) are deleted. The groups and users themselves are kept. ' ~ skillCount ~ ' skill(s) lose this project assignment but are kept. ' ~ testcaseCount ~ ' testcase(s) lose this project assignment but are kept; those without another project become admin-only. ' ~ runCount ~ ' run(s) and their versions are deleted.') }}
    {% else %}
        <h2>Description</h2>
        <p>{{ project.description ?? 'No description.' }}</p>

        <h2>Access</h2>
        <p>Groups: {{ project.groups|length }}</p>
        <p>Users: {{ project.users|length }}</p>
    {% endif %}
{% endblock %}
