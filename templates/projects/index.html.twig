{% extends 'layout.html.twig' %}

{% import '_list/macros.html.twig' as list %}

{% block title %}Projects{% endblock %}

{% block heading %}Projects{% endblock %}

{% block content %}
    {{ include('_list/controls.html.twig', {route: 'app_projects', query: query, page: page}|merge(is_granted('ROLE_ADMIN') ? {newPath: path('app_project_new'), newLabel: 'New project'} : {})) }}

    {% if page.items %}
        <table>
            <thead>
                <tr>
                    {{ list.sort_header('app_projects', {}, query, page, 'title', 'Title') }}
                    <th>Description</th>
                    {{ list.sort_header('app_projects', {}, query, page, 'users', 'Users') }}
                    {{ list.sort_header('app_projects', {}, query, page, 'groups', 'Groups') }}
                    {{ list.sort_header('app_projects', {}, query, page, 'skills', 'Skills') }}
                    {{ list.sort_header('app_projects', {}, query, page, 'testcases', 'Testcases') }}
                    {{ list.sort_header('app_projects', {}, query, page, 'updatedAt', 'Updated') }}
                    {{ list.sort_header('app_projects', {}, query, page, 'createdAt', 'Created') }}
                </tr>
            </thead>
            <tbody>
                {% for row in page.items %}
                    {% set project = row[0] %}
                    <tr>
                        <td><a href="{{ path('app_project_show', {uuid: project.uuid}) }}">{{ project.title }}</a></td>
                        <td>{{ list.excerpt(project.description) }}</td>
                        <td>{{ row.userCount }}</td>
                        <td>{{ row.groupCount }}</td>
                        <td><a href="{{ path('app_skills', {project: project.uuid}) }}">{{ row.skillCount }}</a></td>
                        <td><a href="{{ path('app_testcases', {project: project.uuid}) }}">{{ row.testcaseCount }}</a></td>
                        <td>{{ project.updatedAt|date }}</td>
                        <td>{{ project.createdAt|date }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ list.pagination('app_projects', {}, query, page) }}
    {% else %}
        <p>{{ query.q ? 'No projects found.' : 'No projects yet.' }}</p>
    {% endif %}
{% endblock %}
