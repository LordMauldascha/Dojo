{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}LLM Configuration{% endblock %}

{% block heading %}LLM Configuration{% endblock %}

{% block content %}
    <h2>LLM judge</h2>
    <p class="help-text">The model that rates run outputs against the output criteria of a testcase. {% if judge %}Current: {{ judge.provider.displayName }} / {{ judge.model }}.{% else %}Not set.{% endif %}</p>
    {{ form(judgeForm) }}

    <h2>AI helper</h2>
    <p class="help-text">The model that generates skills and testcases from a description. {% if helper %}Current: {{ helper.provider.displayName }} / {{ helper.model }}.{% else %}Not set.{% endif %}</p>
    {{ form(helperForm) }}

    <h2>API keys</h2>
    <p class="help-text">Keys are stored encrypted and never shown again. A run can use a provider once one of its credentials is set.</p>

    <div class="provider-grid">
        {% for card in cards %}
            <section class="provider-card">
                <h2>
                    <span class="status-dot status-dot--{{ card.configured ? 'final' : 'off' }}" role="img" aria-label="{{ card.configured ? 'Configured' : 'No key' }}"></span>{{ card.provider.displayName }}
                </h2>
                {% if 1 < card.credentials|length %}
                    <p class="help-text">Use one of the two. If both are set, the API key wins. Anthropic has no provider of its own: its key is used by Claude Code.</p>
                {% endif %}

                {% for row in card.credentials %}
                    {% set credential = row.credential %}
                    {% set dialogId = 'key-dialog-' ~ credential.value %}
                    <div class="credential">
                        <div class="credential-head">
                            <strong>{{ credential.label }}</strong>
                            <code>{{ credential.envVar }}</code>
                        </div>
                        <p class="credential-status">
                            {% if row.key %}
                                ••••{{ row.key.lastFour }}, changed {{ row.key.updatedAt|date }}
                            {% else %}
                                Not set
                            {% endif %}
                        </p>
                        <div class="credential-actions">
                            <button type="button" command="show-modal" commandfor="{{ dialogId }}">{{ row.key ? 'Replace key' : 'Set key' }}</button>
                            {% if row.key %}
                                {{ forms.confirm_post(path('app_admin_llm_configuration_key_delete', {credential: credential.value}), constant('App\\Controller\\LlmConfigurationController::CSRF_DELETE_KEY') ~ credential.value, 'Delete', 'Delete ' ~ credential.label ~ '?', 'The stored key is removed. Runs with this provider cannot use it until a new key is saved.') }}
                            {% endif %}
                        </div>

                        <dialog id="{{ prepare_component('dialog', {id: dialogId, showOnLoad: row.form.vars.submitted}) }}" aria-labelledby="{{ dialogId }}-title" closedby="any">
                            <h2 id="{{ dialogId }}-title">{{ row.key ? 'Replace' : 'Set' }} {{ credential.label }}</h2>
                            {{ form_start(row.form) }}
                                {{ form_errors(row.form) }}
                                {{ form_row(row.form.apiKey) }}
                                <div class="dialog-actions">
                                    <button type="button" command="close" commandfor="{{ dialogId }}">Cancel</button>
                                    {{ form_widget(row.form.save) }}
                                </div>
                            {{ form_end(row.form) }}
                        </dialog>
                    </div>
                {% endfor %}

                {% if 'huggingface' == card.provider.value %}
                    <div class="credential">
                        <div class="credential-head">
                            <strong>Models</strong>
                            <a href="{{ path('app_admin_huggingface_models') }}">Discover models</a>
                        </div>
                        {% if huggingFaceModels %}
                            <ul class="model-list">
                                {% for model in huggingFaceModels %}
                                    <li>
                                        <span>{{ model.modelId }}</span>
                                        {{ forms.confirm_post(path('app_admin_huggingface_model_delete', {id: model.id}), constant('App\\Controller\\HuggingFaceModelController::CSRF_DELETE') ~ model.id, 'Remove', 'Remove ' ~ model.modelId ~ '?', 'The model is no longer offered in runs and as judge. Existing run configurations keep it.', null, 'button-danger', '−', 'button-danger button-icon') }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="credential-status">No models added. Only added models are offered in runs and as judge.</p>
                        {% endif %}
                    </div>
                {% endif %}
            </section>
        {% endfor %}
    </div>
{% endblock %}
