{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
    <h1>Users</h1>
    {{ include('_nav.html.twig') }}
    {{ include('_flashes.html.twig') }}

    <h2>Existing users</h2>
    {% if users %}
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.username }}</td>
                        <td>{{ user.role.label }}</td>
                        <td>{{ user.enabled ? 'active' : 'disabled' }}</td>
                        <td>
                            {% if user.userIdentifier != app.user.userIdentifier %}
                                <form method="post" action="{{ path('app_admin_user_toggle', {id: user.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle-user-' ~ user.id) }}">
                                    <button type="submit">{{ user.enabled ? 'Disable' : 'Enable' }}</button>
                                </form>
                                <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                                    <button type="submit">Delete</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No users yet.</p>
    {% endif %}

    <h2>Create new user</h2>
    {{ form(form) }}
{% endblock %}
