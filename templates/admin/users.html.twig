{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}Users{% endblock %}

{% block heading %}Users{% endblock %}

{% block content %}
    <h2>Existing users</h2>
    {% if users %}
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.username }}</td>
                        <td>{{ user.role.label }}</td>
                        <td>{{ user.enabled ? 'active' : 'disabled' }}</td>
                        <td>
                            {% if user.userIdentifier != app.user.userIdentifier %}
                                {{ forms.post(path('app_admin_user_toggle', {id: user.id}), 'toggle-user-' ~ user.id, user.enabled ? 'Disable' : 'Enable') }}
                                {{ forms.confirm_post(path('app_admin_user_delete', {id: user.id}), 'delete-user-' ~ user.id, 'Delete', 'Delete user?', 'The user is deleted and loses access to all projects.') }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No users yet.</p>
    {% endif %}

    <h2>Create new user</h2>
    {{ form(form) }}
{% endblock %}
