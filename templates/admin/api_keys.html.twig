{% extends 'base.html.twig' %}

{% block title %}API Keys{% endblock %}

{% block body %}
    <h1>API Keys</h1>
    {{ include('_nav.html.twig') }}
    {{ include('_flashes.html.twig') }}

    {% for row in rows %}
        <section>
            <h2>{{ row.provider.label }}</h2>
            {% if row.key %}
                <p>
                    Hinterlegt: ••••{{ row.key.lastFour }}
                    (geändert am {{ row.key.updatedAt|date('d.m.Y H:i') }})
                </p>
                <form method="post" action="{{ path('app_admin_api_key_delete', {provider: row.provider.value}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-api-key-' ~ row.provider.value) }}">
                    <button type="submit">Löschen</button>
                </form>
            {% else %}
                <p>Kein Key hinterlegt.</p>
            {% endif %}
            {{ form(row.form) }}
        </section>
    {% endfor %}
{% endblock %}
