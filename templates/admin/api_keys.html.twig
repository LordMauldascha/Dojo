{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}API Keys{% endblock %}

{% block heading %}API Keys{% endblock %}

{% block content %}
    {% for row in rows %}
        <section>
            <h2>{{ row.provider.label }}</h2>
            {% if row.key %}
                <p>
                    Stored: ••••{{ row.key.lastFour }}
                    (changed on {{ row.key.updatedAt|date }})
                </p>
                {{ forms.confirm_post(path('app_admin_api_key_delete', {provider: row.provider.value}), 'delete-api-key-' ~ row.provider.value, 'Delete', 'Delete ' ~ row.provider.label ~ '?', 'The stored key is removed. Runs with this provider cannot use it until a new key is saved.') }}
            {% else %}
                <p>No key stored.</p>
            {% endif %}
            {{ form(row.form) }}
        </section>
    {% endfor %}
{% endblock %}
