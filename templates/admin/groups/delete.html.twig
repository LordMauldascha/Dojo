{% extends 'base.html.twig' %}

{% block title %}Gruppe löschen{% endblock %}

{% block body %}
    <h1>Gruppe {{ group.title }} löschen</h1>
    {{ include('_nav.html.twig') }}
    {{ include('_flashes.html.twig') }}

    {% if projects %}
        <p>Die Gruppe wird aus diesen Projekten entfernt, die Berechtigungen ihrer Mitglieder entfallen:</p>
        <ul>
            {% for project in projects %}
                <li>{{ project.title }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Die Gruppe ist keinem Projekt zugewiesen.</p>
    {% endif %}

    <form method="post" action="{{ path('app_admin_group_delete', {uuid: group.uuid}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-group-' ~ group.uuid) }}">
        <button type="submit">Endgültig löschen</button>
    </form>
    <p><a href="{{ path('app_admin_group_show', {uuid: group.uuid}) }}">Abbrechen</a></p>
{% endblock %}
