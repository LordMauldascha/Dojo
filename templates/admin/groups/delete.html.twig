{% extends 'delete.html.twig' %}

{% set action = path('app_admin_group_delete', {uuid: group.uuid}) %}
{% set tokenId = 'delete-group-' ~ group.uuid %}
{% set cancelUrl = path('app_admin_group_show', {uuid: group.uuid}) %}

{% block title %}Delete group{% endblock %}

{% block heading %}Delete group {{ group.title }}{% endblock %}

{% block message %}
    {% if projects %}
        <p>The group is removed from these projects, and its members lose the access it granted:</p>
        <ul>
            {% for project in projects %}
                <li>{{ project.title }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>The group is not assigned to any project.</p>
    {% endif %}
{% endblock %}
