{% extends 'base.html.twig' %}

{% block title %}Delete group{% endblock %}

{% block body %}
    <h1>Delete group {{ group.title }}</h1>
    {{ include('_nav.html.twig') }}
    {{ include('_flashes.html.twig') }}

    {% if projects %}
        <p>The group is removed from these projects, and its members lose the access it granted:</p>
        <ul>
            {% for project in projects %}
                <li>{{ project.title }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>The group is not assigned to any project.</p>
    {% endif %}

    <form method="post" action="{{ path('app_admin_group_delete', {uuid: group.uuid}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-group-' ~ group.uuid) }}">
        <button type="submit">Delete permanently</button>
    </form>
    <p><a href="{{ path('app_admin_group_show', {uuid: group.uuid}) }}">Cancel</a></p>
{% endblock %}
