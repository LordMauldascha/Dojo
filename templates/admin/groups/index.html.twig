{% extends 'base.html.twig' %}

{% import '_list/macros.html.twig' as list %}

{% block title %}Gruppen{% endblock %}

{% block body %}
    <h1>Gruppen</h1>
    {{ include('_nav.html.twig') }}
    {{ include('_flashes.html.twig') }}

    <p><a href="{{ path('app_admin_group_new') }}">Neue Gruppe</a></p>

    {{ include('_list/controls.html.twig', {route: 'app_admin_groups', query: query, page: page}) }}

    {% if page.items %}
        <table>
            <thead>
                <tr>
                    {{ list.sort_header('app_admin_groups', {}, query, page, 'title', 'Titel') }}
                    {{ list.sort_header('app_admin_groups', {}, query, page, 'users', 'Benutzer') }}
                    {{ list.sort_header('app_admin_groups', {}, query, page, 'updatedAt', 'Aktualisiert') }}
                    {{ list.sort_header('app_admin_groups', {}, query, page, 'createdAt', 'Erstellt') }}
                </tr>
            </thead>
            <tbody>
                {% for row in page.items %}
                    {% set group = row[0] %}
                    <tr>
                        <td><a href="{{ path('app_admin_group_show', {uuid: group.uuid}) }}">{{ group.title }}</a></td>
                        <td>{{ row.userCount }}</td>
                        <td>{{ group.updatedAt|date }}</td>
                        <td>{{ group.createdAt|date }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ list.pagination('app_admin_groups', {}, query, page) }}
    {% else %}
        <p>{{ query.q ? 'Keine Gruppen gefunden.' : 'Noch keine Gruppen angelegt.' }}</p>
    {% endif %}
{% endblock %}
