{% extends 'layout.html.twig' %}

{% import '_list/macros.html.twig' as list %}

{% block title %}Groups{% endblock %}

{% block heading %}Groups{% endblock %}

{% block content %}
    <p><a href="{{ path('app_admin_group_new') }}">New group</a></p>

    {{ include('_list/controls.html.twig', {route: 'app_admin_groups', query: query, page: page}) }}

    {% if page.items %}
        <table>
            <thead>
                <tr>
                    {{ list.sort_header('app_admin_groups', {}, query, page, 'title', 'Title') }}
                    {{ list.sort_header('app_admin_groups', {}, query, page, 'users', 'Users') }}
                    {{ list.sort_header('app_admin_groups', {}, query, page, 'updatedAt', 'Updated') }}
                    {{ list.sort_header('app_admin_groups', {}, query, page, 'createdAt', 'Created') }}
                </tr>
            </thead>
            <tbody>
                {% for row in page.items %}
                    {% set group = row[0] %}
                    <tr>
                        <td><a href="{{ path('app_admin_group_show', {uuid: group.uuid}) }}">{{ group.title }}</a></td>
                        <td>{{ row.userCount }}</td>
                        <td>{{ group.updatedAt|date }}</td>
                        <td>{{ group.createdAt|date }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ list.pagination('app_admin_groups', {}, query, page) }}
    {% else %}
        <p>{{ query.q ? 'No groups found.' : 'No groups yet.' }}</p>
    {% endif %}
{% endblock %}
