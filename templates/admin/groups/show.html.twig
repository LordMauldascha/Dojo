{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}Group {{ group.title }}{% endblock %}

{% block heading %}Group {{ group.title }}{% endblock %}

{% block content %}
    {{ include('_back_link.html.twig', {href: path('app_admin_groups'), label: 'Back to overview'}) }}

    <h2>Title</h2>
    {{ form(form) }}

    <h2>Members</h2>
    {% if group.users|length %}
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in group.users %}
                    <tr>
                        <td>{{ user.username }}</td>
                        <td>{{ user.role.label }}</td>
                        <td>
                            {{ forms.post(path('app_admin_group_user_remove', {uuid: group.uuid, userId: user.id}), 'remove-group-user-' ~ group.uuid ~ '-' ~ user.id, 'Remove') }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No members yet.</p>
    {% endif %}

    {{ form(addUserForm) }}

    <h2>Delete group</h2>
    {{ forms.confirm_post(path('app_admin_group_delete', {uuid: group.uuid}), 'delete-group-' ~ group.uuid, 'Delete', 'Delete group?', projects ? 'The group is removed from these projects, and its members lose the access it granted: ' ~ projects|map(project => project.title)|join(', ') ~ '.' : 'The group is not assigned to any project.') }}
{% endblock %}
