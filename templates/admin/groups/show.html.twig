{% extends 'base.html.twig' %}

{% block title %}Group {{ group.title }}{% endblock %}

{% block body %}
    <h1>Group {{ group.title }}</h1>
    {{ include('_nav.html.twig') }}
    {{ include('_flashes.html.twig') }}

    <p><a href="{{ path('app_admin_groups') }}">Back to overview</a></p>

    <h2>Title</h2>
    {{ form(form) }}

    <h2>Members</h2>
    {% if group.users|length %}
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in group.users %}
                    <tr>
                        <td>{{ user.username }}</td>
                        <td>{{ user.role.label }}</td>
                        <td>
                            <form method="post" action="{{ path('app_admin_group_user_remove', {uuid: group.uuid, userId: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('remove-group-user-' ~ group.uuid ~ '-' ~ user.id) }}">
                                <button type="submit">Remove</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No members yet.</p>
    {% endif %}

    {{ form(addUserForm) }}

    <h2>Delete group</h2>
    <p><a href="{{ path('app_admin_group_delete', {uuid: group.uuid}) }}">Delete</a></p>
{% endblock %}
