{% extends 'layout.html.twig' %}
{% import '_forms.html.twig' as forms %}

{% block title %}My account{% endblock %}

{% block heading %}My account{% endblock %}

{% block content %}
    {% set user = app.user %}

    <h2>Profile</h2>
    <dl class="facts">
        <div>
            <dt>Username</dt>
            <dd>{{ user.userIdentifier }}</dd>
        </div>
        <div>
            <dt>Role</dt>
            <dd>{{ user.role.label }}</dd>
        </div>
        <div>
            <dt>Account created</dt>
            <dd>{{ user.createdAt ? user.createdAt|date : '–' }}</dd>
        </div>
        <div>
            <dt>Last sign-in</dt>
            <dd>{{ user.lastLoginAt ? user.lastLoginAt|date : '–' }}</dd>
        </div>
    </dl>

    <h2>Overview</h2>
    <dl class="stats">
        <div class="stat">
            <dt>Projects</dt>
            <dd><a href="{{ path('app_projects') }}">{{ counts.projects }}</a></dd>
        </div>
        <div class="stat">
            <dt>Groups</dt>
            <dd>{{ counts.groups }}</dd>
        </div>
        <div class="stat">
            <dt>Skills created</dt>
            <dd>{{ counts.skills }}</dd>
        </div>
        <div class="stat">
            <dt>Testcases created</dt>
            <dd>{{ counts.testcases }}</dd>
        </div>
        <div class="stat">
            <dt>Runs created</dt>
            <dd>{{ counts.runs }}</dd>
        </div>
    </dl>

    <h2>My groups</h2>
    {% if groups %}
        <table>
            <thead>
                <tr>
                    <th>Group</th>
                    <th>Members</th>
                </tr>
            </thead>
            <tbody>
                {% for row in groups %}
                    {% set group = row[0] %}
                    <tr>
                        <td>
                            {%- if is_granted('ROLE_ADMIN') -%}
                                <a href="{{ path('app_admin_group_show', {uuid: group.uuid}) }}">{{ group.title }}</a>
                            {%- else -%}
                                {{ group.title }}
                            {%- endif -%}
                        </td>
                        <td>{{ row.userCount }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No groups yet.</p>
    {% endif %}

    <h2>My projects</h2>
    {{ include('_projects_table.html.twig') }}

    <h2>Connected agents</h2>
    {% if agents %}
        <table>
            <thead>
                <tr>
                    <th>Agent</th>
                    <th>Connected until</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for agent in agents %}
                    <tr>
                        <td>{{ agent.name }}</td>
                        <td>{{ agent.validUntil|date }}</td>
                        <td>{{ forms.confirm_post(path('app_account_agent_revoke', {clientId: agent.clientId}), constant('App\\Controller\\AccountController::CSRF_REVOKE_AGENT') ~ agent.clientId, 'Disconnect', 'Disconnect agent?', agent.name ~ ' can no longer act as you. It has to be approved again to reconnect.') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No agents connected. Connect one, for example Claude Code: <code>claude mcp add --transport http dojo {{ url('_mcp_endpoint_default') }}</code></p>
    {% endif %}

    <h2>Security</h2>
    <p><button type="button" command="show-modal" commandfor="password-dialog">Change password</button></p>
    <dialog id="{{ prepare_component('dialog', {id: 'password-dialog', showOnLoad: form.vars.submitted}) }}" aria-labelledby="password-dialog-title" closedby="any">
        <h2 id="password-dialog-title">Change password</h2>
        {{ form_start(form, {action: path('app_account_password')}) }}
            {{ form_errors(form) }}
            {{ form_row(form.currentPassword) }}
            {{ form_errors(form.newPassword) }}
            {{ form_row(form.newPassword.first) }}
            {{ form_row(form.newPassword.second) }}
            <div class="dialog-actions">
                <button type="button" command="close" commandfor="password-dialog">Cancel</button>
                {{ form_widget(form.save) }}
            </div>
        {{ form_end(form) }}
    </dialog>
{% endblock %}
