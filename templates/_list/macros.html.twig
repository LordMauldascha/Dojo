{# Sortable column header. Toggles the direction of the active column and returns to page 1. #}
{% macro sort_header(route, routeParams, query, page, field, label) %}
    {% set active = field == (query.sort ?? 'title') %}
    {% set nextDir = active and 'asc' == query.dir ? 'desc' : 'asc' %}
    <th{% if active %} aria-sort="{{ 'asc' == query.dir ? 'ascending' : 'descending' }}"{% endif %}>
        <a href="{{ path(route, routeParams|merge({q: query.q ?: null, project: query.project ?: null, sort: field, dir: nextDir, perPage: page.perPage, page: 1})) }}">{{ label }}</a>
    </th>
{% endmacro %}

{% macro pagination(route, routeParams, query, page) %}
    {% set base = {q: query.q ?: null, project: query.project ?: null, sort: query.sort, dir: 'asc' == query.dir ? null : query.dir, perPage: page.perPage} %}
    <nav aria-label="Pagination">
        {% if 1 < page.page %}
            <a class="button" href="{{ path(route, routeParams|merge(base)|merge({page: page.page - 1})) }}" rel="prev">Previous</a>
        {% else %}
            <span class="button" aria-disabled="true">Previous</span>
        {% endif %}
        <span>Page {{ page.page }} of {{ page.pageCount }} ({{ page.total }} {{ 1 == page.total ? 'entry' : 'entries' }})</span>
        {% if page.page < page.pageCount %}
            <a class="button" href="{{ path(route, routeParams|merge(base)|merge({page: page.page + 1})) }}" rel="next">Next</a>
        {% else %}
            <span class="button" aria-disabled="true">Next</span>
        {% endif %}
    </nav>
{% endmacro %}

{# First characters of a text, with an ellipsis when it was cut. #}
{% macro excerpt(text, length = 100) %}
    {%- set text = text ?? '' -%}
    {{- text|slice(0, length) }}{{ length < text|length ? '…' -}}
{% endmacro %}
