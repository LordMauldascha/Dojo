{% extends 'layout.html.twig' %}

{% import '_list/macros.html.twig' as list %}

{% block title %}Skills{% endblock %}

{% block heading %}Skills{% endblock %}

{% block content %}
    <p><a href="{{ path('app_skill_new') }}">New skill</a></p>

    {{ include('_list/controls.html.twig', {route: 'app_skills', query: query, page: page, projectChoices: projectChoices}) }}

    {% if page.items %}
        <table>
            <thead>
                <tr>
                    {{ list.sort_header('app_skills', {}, query, page, 'title', 'Title') }}
                    <th>Description</th>
                    <th>Projects</th>
                    <th>Runs</th>
                    {{ list.sort_header('app_skills', {}, query, page, 'updatedAt', 'Updated') }}
                    {{ list.sort_header('app_skills', {}, query, page, 'createdAt', 'Created') }}
                </tr>
            </thead>
            <tbody>
                {% for skill in page.items %}
                    {% set titles = [] %}
                    {% for project in skill.projects %}
                        {% if project.id in visibleProjectIds %}
                            {% set titles = titles|merge([project.title]) %}
                        {% endif %}
                    {% endfor %}
                    <tr>
                        <td><a href="{{ path('app_skill_show', {uuid: skill.uuid}) }}">{{ skill.activeVersion.title }}</a></td>
                        <td>{{ list.excerpt(skill.activeVersion.description) }}</td>
                        <td>{{ titles|join(', ') }}</td>
                        <td>{{ runCounts[skill.id] ?? 0 }}</td>
                        <td>{{ skill.updatedAt|date }}</td>
                        <td>{{ skill.createdAt|date }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ list.pagination('app_skills', {}, query, page) }}
    {% else %}
        <p>{{ query.q or query.project ? 'No skills found.' : 'No skills yet.' }}</p>
    {% endif %}
{% endblock %}
