{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}Skill {{ skill.activeVersion.title }}{% endblock %}

{% block heading %}Skill {{ skill.activeVersion.title }}{% endblock %}

{% block content %}
    {% set active = skill.activeVersion %}
    {% set draft = skill.draft %}

    <p><a href="{{ path('app_skills') }}">Back to overview</a></p>

    <p>Active version: {{ active.label }}</p>
    {% if 0 < hiddenProjectCount %}
        <p>This skill is also assigned to {{ hiddenProjectCount }} project(s) you cannot see. Changes apply there too.</p>
    {% endif %}
    {% if draft %}
        <p>Draft {{ draft.label }} exists and is shown in the form below. It is ignored until it is saved as final.</p>
    {% endif %}

    <h2>Edit</h2>
    {{ form(form) }}
    {% if draft %}
        {{ forms.post(path('app_skill_draft_discard', {uuid: skill.uuid}), 'discard-skill-draft-' ~ skill.uuid, 'Discard draft') }}
    {% endif %}

    <h2>Projects</h2>
    {{ form(projectsForm) }}

    {{ include('_versions.html.twig', {entity: skill, versionRoute: 'app_skill_version', restoreRoute: 'app_skill_restore', restoreTokenPrefix: 'restore-skill-'}) }}

    {% if canDelete %}
        <h2>Delete skill</h2>
        <p><a href="{{ path('app_skill_delete', {uuid: skill.uuid}) }}">Delete</a></p>
    {% endif %}
{% endblock %}
