{% extends 'delete.html.twig' %}

{% set action = path('app_skill_delete', {uuid: skill.uuid}) %}
{% set tokenId = 'delete-skill-' ~ skill.uuid %}
{% set cancelUrl = path('app_skill_show', {uuid: skill.uuid}) %}
{% set label = 'Delete' %}

{% block title %}Delete skill{% endblock %}

{% block heading %}Delete skill {{ skill.activeVersion.title }}{% endblock %}

{% block message %}
    <p>The skill disappears from all lists and projects. Its version history is kept in the database.</p>
{% endblock %}
