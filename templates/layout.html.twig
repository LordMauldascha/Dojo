{# Frame of every signed-in page: sidebar with navigation, then heading, flash messages and the page content. #}
{% extends 'base.html.twig' %}

{% block body %}
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="app">
        <header class="app-sidebar">
            <a class="brand" href="{{ path('app_home') }}">Dojo<span class="brand-mark" aria-hidden="true"></span></a>
            {{ include('_nav.html.twig') }}
        </header>
        <main class="app-main" id="content">
            <h1>{% block heading %}{% endblock %}</h1>
            {{ include('_flashes.html.twig') }}

            {% block content %}{% endblock %}
        </main>
    </div>
{% endblock %}
