{# Frame of every signed-in page: sidebar with navigation, then heading, flash messages and the page content. #}
{% extends 'base.html.twig' %}

{% block body %}
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="app">
        <header class="app-sidebar">
            <a class="brand" href="{{ path('app_home') }}"><span class="seal" aria-hidden="true">道</span>Dojo</a>
            {{ include('_nav.html.twig') }}
        </header>
        <main class="app-main" id="content">
            <h1>{% block heading %}{% endblock %}</h1>
            {{ include('_flashes.html.twig') }}

            {% block content %}{% endblock %}
        </main>
    </div>

    <dialog id="{{ prepare_component('unsaved-changes', {id: 'unsaved-dialog'}) }}" aria-labelledby="unsaved-dialog-title" closedby="any">
        <h2 id="unsaved-dialog-title">Discard changes?</h2>
        <p>You have unsaved changes on this page. If you leave, they are discarded.</p>
        <div class="dialog-actions">
            <button type="button" command="close" commandfor="unsaved-dialog" autofocus>Stay</button>
            <button type="button" class="button-danger" data-unsaved-leave>Discard changes</button>
        </div>
    </dialog>
{% endblock %}
