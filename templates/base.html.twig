<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#2c2015">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('styles') }}
        {% endblock %}
        {# View transitions (docs/Design.md). The opt-in is inline: in Chromium 158 it was ignored inside the external stylesheet. #}
        <style>
            @view-transition { navigation: auto; }
            @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
        </style>
        {# Glow phase from the clock: a page change continues the light instead of restarting it dark (docs/Design.md). One full cycle is twice the duration in _layout.scss (11 s and 7 s). #}
        <script>
            (function () {
                var t = Date.now() / 1000;
                document.documentElement.style.setProperty('--glow-delay-wide', -(t % 22) + 's');
                document.documentElement.style.setProperty('--glow-delay-core', -(t % 14) + 's');
            })();
        </script>
        {# Login animation (docs/Design.md): after a login attempt the next page starts covered by the tatami mats (class set before the first paint, the view transition is skipped) and assets/js/components/tatamiCover.ts rolls them away. #}
        <script>
            (function () {
                try {
                    var started = Number(sessionStorage.getItem('dojo-tatami'));
                    if (started && Date.now() - started < 15000 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
                        document.documentElement.classList.add('tatami-cover');
                        addEventListener('pagereveal', function (event) {
                            if (event.viewTransition) {
                                event.viewTransition.skipTransition();
                            }
                        });
                    } else {
                        sessionStorage.removeItem('dojo-tatami');
                    }
                } catch (error) {}
            })();
        </script>
        {# Do not paint the new page before its content element is parsed. Every page needs main#content. #}
        <link rel="expect" href="#content" blocking="render">

        {% do prepare_service('prevent-double-submit', 'enable') %}
        {% do prepare_service('command-buttons', 'support') %}
        {% do prepare_service('password-toggle', 'enable') %}
        {% do prepare_service('skill-header', 'enable') %}

        {% block javascripts %}
            {{ encore_entry_script_tags('scripts') }}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload and 'dev' == app.environment %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <div class="tatami" id="{{ prepare_component('tatami-cover') }}" aria-hidden="true">
            <span class="tatami-mat"><span class="tatami-sheet"></span><span class="tatami-roll"></span></span>
            <span class="tatami-mat"><span class="tatami-sheet"></span><span class="tatami-roll"></span></span>
            <span class="tatami-mat"><span class="tatami-sheet"></span><span class="tatami-roll"></span></span>
        </div>
        {% block body %}{% endblock %}

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                web.startComponents({{ get_components() }});
                web.callServices({{ get_services() }});
            });
        </script>
    </body>
</html>
