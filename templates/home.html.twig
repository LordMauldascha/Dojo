{% extends 'base.html.twig' %}

{% block title %}Overview{% endblock %}

{% block body %}
    <h1>Overview</h1>
    {{ include('_nav.html.twig') }}
    {{ include('_flashes.html.twig') }}

    <h2>Provider</h2>
    <table>
        <thead>
            <tr>
                <th>Provider</th>
                <th>Status</th>
                <th>Last changed</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td>{{ row.provider.label }}</td>
                    <td>{{ row.key ? 'set' : 'not set' }}</td>
                    <td>{{ row.key ? row.key.updatedAt|date('d.m.Y H:i') : '–' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if userCount is not null %}
        <h2>Users</h2>
        <p>Existing users: {{ userCount }}</p>
    {% endif %}
{% endblock %}
