{% extends 'layout.html.twig' %}

{% block title %}Overview{% endblock %}

{% block heading %}Overview{% endblock %}

{% block content %}
    <h2>Provider</h2>
    <table>
        <thead>
            <tr>
                <th>Provider</th>
                <th>Status</th>
                <th>Last changed</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td>{{ row.provider.label }}</td>
                    <td>{{ row.key ? 'set' : 'not set' }}</td>
                    <td>{{ row.key ? row.key.updatedAt|date : '–' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if userCount is not null %}
        <h2>Users</h2>
        <p>Existing users: {{ userCount }}</p>
    {% endif %}
{% endblock %}
