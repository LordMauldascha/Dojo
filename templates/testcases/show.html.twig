{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}Testcase {{ testcase.activeVersion.title }}{% endblock %}

{% block heading %}Testcase {{ testcase.activeVersion.title }}{% endblock %}

{% block content %}
    {% set active = testcase.activeVersion %}
    {% set draft = testcase.draft %}

    <p><a href="{{ path('app_testcases') }}">Back to overview</a></p>

    <p>Active version: {{ active.label }}</p>
    {% if draft %}
        <p>Draft {{ draft.label }} exists and is shown in the form below. It is ignored until it is saved as final.</p>
    {% endif %}

    <h2>Edit</h2>
    {{ form(form) }}
    {% if draft %}
        {{ forms.confirm_post(path('app_testcase_draft_discard', {uuid: testcase.uuid}), 'discard-testcase-draft-' ~ testcase.uuid, 'Discard draft', 'Discard draft?', 'The unfinished draft is deleted. The final versions are kept.') }}
    {% endif %}

    <h2>Project</h2>
    {{ form(projectForm) }}

    {{ include('_versions.html.twig', {entity: testcase, versionRoute: 'app_testcase_version', restoreRoute: 'app_testcase_restore', restoreTokenPrefix: 'restore-testcase-'}) }}

    {% if canDelete %}
        <h2>Delete testcase</h2>
        {{ forms.confirm_post(path('app_testcase_delete', {uuid: testcase.uuid}), 'delete-testcase-' ~ testcase.uuid, 'Delete', 'Delete testcase?', 'The testcase disappears from all lists. Its version history is kept in the database.') }}
    {% endif %}
{% endblock %}
