{% extends 'layout.html.twig' %}

{% import '_list/macros.html.twig' as list %}

{% block title %}Testcases{% endblock %}

{% block heading %}Testcases{% endblock %}

{% block content %}
    {{ include('_list/controls.html.twig', {route: 'app_testcases', query: query, page: page, projectChoices: projectChoices, newPath: path('app_testcase_new'), newLabel: 'New testcase'}) }}

    {% if page.items %}
        <table>
            <thead>
                <tr>
                    {{ list.sort_header('app_testcases', {}, query, page, 'title', 'Title') }}
                    <th>Description</th>
                    <th>Projects</th>
                    <th>Version</th>
                    {{ list.sort_header('app_testcases', {}, query, page, 'updatedAt', 'Updated') }}
                    {{ list.sort_header('app_testcases', {}, query, page, 'createdAt', 'Created') }}
                </tr>
            </thead>
            <tbody>
                {% for testcase in page.items %}
                    {% set titles = [] %}
                    {% for project in testcase.projects %}
                        {% if project.id in visibleProjectIds %}
                            {% set titles = titles|merge([project.title]) %}
                        {% endif %}
                    {% endfor %}
                    <tr>
                        <td><a href="{{ path('app_testcase_show', {uuid: testcase.uuid}) }}">{{ testcase.activeVersion.title }}</a></td>
                        <td>{{ list.excerpt(testcase.activeVersion.description) }}</td>
                        <td>{{ titles|join(', ') }}</td>
                        <td>{{ list.version_status(testcase.activeVersion.number, draftNumbers[testcase.id] ?? null) }}</td>
                        <td>{{ testcase.updatedAt|date }}</td>
                        <td>{{ testcase.createdAt|date }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ list.pagination('app_testcases', {}, query, page) }}
    {% else %}
        <p>{{ query.q or query.project ? 'No testcases found.' : 'No testcases yet.' }}</p>
    {% endif %}
{% endblock %}
