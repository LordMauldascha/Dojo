{% extends 'delete.html.twig' %}

{% set action = path('app_testcase_delete', {uuid: testcase.uuid}) %}
{% set tokenId = 'delete-testcase-' ~ testcase.uuid %}
{% set cancelUrl = path('app_testcase_show', {uuid: testcase.uuid}) %}
{% set label = 'Delete' %}

{% block title %}Delete testcase{% endblock %}

{% block heading %}Delete testcase {{ testcase.activeVersion.title }}{% endblock %}

{% block message %}
    <p>The testcase disappears from all lists. Its version history is kept in the database.</p>
{% endblock %}
