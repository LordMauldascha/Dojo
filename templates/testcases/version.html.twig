{% extends 'layout.html.twig' %}

{% block title %}Testcase {{ version.title }} – version {{ version.label }}{% endblock %}

{% block heading %}{{ version.title }} – version {{ version.label }}{% endblock %}

{% block content %}
    <p><a href="{{ path('app_testcase_show', {uuid: testcase.uuid}) }}">Back to testcase</a></p>

    <p>Saved: {{ version.savedAt|date }}</p>

    <h2>Description</h2>
    <p>{{ version.description ?? 'No description.' }}</p>

    <h2>Prompt</h2>
    <pre>{{ version.prompt }}</pre>

    <h2>Expected output</h2>
    <pre>{{ version.expectedOutput }}</pre>
{% endblock %}
