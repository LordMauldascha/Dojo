{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block title %}Run {{ storedTitle }}{% endblock %}

{% block heading %}Run {{ storedTitle }}{% endblock %}

{% block content %}
    {% set latest = run.latestVersion %}

    {{ include('_back_link.html.twig', {href: path('app_runs', {uuid: run.project.uuid}), label: 'Back to runs of project ' ~ run.project.title}) }}

    <dl class="stats">
        <div class="stat stat--wide">
            <dt>Versions</dt>
            <dd>
                <a href="#versions">{{ run.versions|length }}</a>
                {{ forms.post(path('app_run_start', {uuid: run.uuid}), constant('App\\Controller\\RunController::CSRF_START') ~ run.uuid, 'Start', 'button-primary') }}
            </dd>
        </div>
        <div class="stat">
            <dt>Configurations</dt>
            <dd>{{ run.configurations|length }}</dd>
        </div>
        <div class="stat">
            <dt>Skills</dt>
            <dd>{{ run.skills|length }}</dd>
        </div>
        <div class="stat">
            <dt>Testcases</dt>
            <dd>{{ run.testcases|length }}</dd>
        </div>
    </dl>
    {% if not run.testcases|length and not run.configurations|length %}
        <p class="help-text">To start, add at least one testcase and one LLM configuration.</p>
    {% elseif not run.testcases|length %}
        <p class="help-text">To start, add at least one testcase.</p>
    {% elseif not run.configurations|length %}
        <p class="help-text">To start, add at least one LLM configuration.</p>
    {% endif %}

    {% if run.versions|length %}
        <h2 id="versions">Versions</h2>
        <table>
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for version in run.versions|reverse %}
                    <tr>
                        <td>{{ version.number }}</td>
                        <td>{{ version.createdAt|date }}</td>
                        <td><a href="{{ path('app_run_version', {uuid: run.uuid, number: version.number}) }}">View</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if 1 < run.versions|length %}
            <p><a href="{{ path('app_run_compare', {uuid: run.uuid}) }}">Compare versions</a></p>
        {% endif %}
    {% endif %}

    <h2>Details</h2>
    {{ form(form) }}

    <h2>LLM configurations</h2>
    {% if run.configurations %}
        <table>
            <thead>
                <tr>
                    <th>Provider / model / effort</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for configuration in run.configurations %}
                    <tr>
                        <td>{{ configuration.label }}</td>
                        <td>
                            {{ forms.post(path('app_run_configuration_remove', {uuid: run.uuid, key: configuration.key}), constant('App\\Controller\\RunController::CSRF_REMOVE_CONFIGURATION') ~ run.uuid ~ '-' ~ configuration.key, 'Remove') }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No configurations yet.</p>
    {% endif %}
    {{ form(configurationForm) }}

    <div class="split">
        <section>
            <h2>Skills</h2>
            <p class="help-text">Only skills assigned to this run's project can be selected.</p>
            {% if hasSkills %}
                {{ form(skillsForm) }}
            {% else %}
                <p>The project has no skills.</p>
            {% endif %}
        </section>

        <section>
            <h2>Testcases</h2>
            <p class="help-text">Only testcases of this run's project can be selected.</p>
            {% if hasTestcases %}
                {{ form(testcasesForm) }}
            {% else %}
                <p>The project has no testcases.</p>
            {% endif %}
        </section>
    </div>

    {% if canDelete %}
        <h2>Delete run</h2>
        {{ forms.confirm_post(path('app_run_delete', {uuid: run.uuid}), constant('App\\Controller\\RunController::CSRF_DELETE') ~ run.uuid, 'Delete', 'Delete run?', 'The run and its ' ~ run.versions|length ~ ' version(s) are deleted for good. Skills and testcases are kept.') }}
    {% endif %}
{% endblock %}
