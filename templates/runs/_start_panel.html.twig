{% import '_forms.html.twig' as forms %}
{% set latest = run.latestVersion %}
<dl class="stats">
    <div class="stat stat--wide">
        <dt>Versions</dt>
        <dd>
            <a href="#versions">{{ run.versions|length }}</a>
            {% if latest %}
                <a href="{{ path('app_run_version', {uuid: run.uuid, number: latest.number}) }}" class="help-text" data-version-status>Version {{ latest.number }}: {{ latest.statusLabel }}</a>
            {% endif %}
            {% if startCheck.canStart and startCheck.baselineAvailable %}
                {% set tokenId = constant('App\\Controller\\RunController::CSRF_START') ~ run.uuid %}
                {% set dialogId = 'confirm-' ~ tokenId %}
                <button type="button" class="button-primary" command="show-modal" commandfor="{{ dialogId }}">Start</button>
                <dialog id="{{ dialogId }}" aria-labelledby="{{ dialogId }}-title" closedby="any">
                    <h2 id="{{ dialogId }}-title">Start run?</h2>
                    <p>This is the first version and it uses skills. Also start a baseline without skills, so the version with skills has a version to be compared with?</p>
                    <p>Without baseline this makes {{ startCheck.llmCalls }} LLM calls and {{ startCheck.judgeCalls }} judge calls, with baseline {{ 2 * startCheck.llmCalls }} and {{ 2 * startCheck.judgeCalls }}. This may cost money.</p>
                    <form method="post" action="{{ path('app_run_start', {uuid: run.uuid}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">
                        <button type="button" command="close" commandfor="{{ dialogId }}" autofocus>Cancel</button>
                        <button type="submit" name="baseline" value="0" class="button-primary">Start without baseline</button>
                        <button type="submit" name="baseline" value="1" class="button-primary">Start with baseline</button>
                    </form>
                </dialog>
            {% elseif startCheck.canStart %}
                {{ forms.confirm_post(path('app_run_start', {uuid: run.uuid}), constant('App\\Controller\\RunController::CSRF_START') ~ run.uuid, 'Start', 'Start run?', 'This makes ' ~ startCheck.llmCalls ~ ' LLM calls and ' ~ startCheck.judgeCalls ~ ' judge calls, which may cost money.', null, 'button-primary') }}
            {% else %}
                {{ forms.post(path('app_run_start', {uuid: run.uuid}), constant('App\\Controller\\RunController::CSRF_START') ~ run.uuid, 'Start', 'button-primary') }}
            {% endif %}
        </dd>
    </div>
    <div class="stat">
        <dt>Configurations</dt>
        <dd>{{ run.configurations|length }}</dd>
    </div>
    <div class="stat">
        <dt>Skills</dt>
        <dd>{{ run.skills|length }}</dd>
    </div>
    <div class="stat">
        <dt>Testcases</dt>
        <dd>{{ run.testcases|length }}</dd>
    </div>
</dl>
{# deleted testcases do not count, as in the start check #}
{% set noTestcase = constant('App\\Run\\RunStarter::NO_TESTCASE') in startCheck.problems %}
{% if noTestcase and not run.configurations|length %}
    <p class="help-text">To start, add at least one testcase and one LLM configuration.</p>
{% elseif noTestcase %}
    <p class="help-text">To start, add at least one testcase.</p>
{% elseif not run.configurations|length %}
    <p class="help-text">To start, add at least one LLM configuration.</p>
{% endif %}
{% for problem in startProblems %}
    <p class="help-text">
        {{ problem }}
        {% if problem in [constant('App\\Run\\RunStarter::NO_JUDGE'), constant('App\\Run\\RunStarter::JUDGE_WITHOUT_KEY'), constant('App\\Run\\RunStarter::JUDGE_MODEL_UNAVAILABLE')] and is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin_llm_configuration') }}">Open the LLM configuration</a>
        {% endif %}
    </p>
{% endfor %}

{% if run.versions|length %}
    <h2 id="versions">Versions</h2>
    <table>
        <thead>
            <tr>
                <th>Version</th>
                <th>Created</th>
                <th>Criteria met</th>
                <th>Avg. duration</th>
                <th>Avg. input tokens</th>
                <th>Avg. output tokens</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for version in run.versions|reverse %}
                <tr>
                    <td>{{ version.number }}</td>
                    <td>{{ version.createdAt|date }}</td>
                    <td data-criteria-score>{{ version.criteriaScore is null ? '–' : version.criteriaScore ~ ' %' }}</td>
                    <td data-avg-duration>{{ version.averageDurationMs is null ? '–' : (version.averageDurationMs / 1000)|number_format(1) ~ ' s' }}</td>
                    <td data-avg-input-tokens>{{ version.averageInputTokens is null ? '–' : version.averageInputTokens|number_format }}</td>
                    <td data-avg-output-tokens>{{ version.averageOutputTokens is null ? '–' : version.averageOutputTokens|number_format }}</td>
                    <td><a href="{{ path('app_run_version', {uuid: run.uuid, number: version.number}) }}">View</a></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% if 1 < run.versions|length %}
        <p><a href="{{ path('app_run_compare', {uuid: run.uuid}) }}">Compare versions</a></p>
    {% endif %}
{% endif %}
