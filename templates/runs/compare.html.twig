{% extends 'layout.html.twig' %}

{% macro version_select(label, name, versions, selected) %}
    <label>{{ label }}
        <select name="{{ name }}">
            {% if null is same as selected %}
                <option value="" selected></option>
            {% endif %}
            {% for version in versions %}
                <option value="{{ version.number }}"{{ selected and version.number == selected.number ? ' selected' }}>{{ version.number }}</option>
            {% endfor %}
        </select>
    </label>
{% endmacro %}

{# Added, removed and changed skills or testcases of a diff. "owner" is the property of a version that names the skill or testcase. #}
{% macro changes(heading, added, removed, changed, owner) %}
    {% if added or removed or changed %}
        <h3>{{ heading }}</h3>
        <ul>
            {% for version in added %}
                <li>Added: {{ version.title }} (version {{ version.number }})</li>
            {% endfor %}
            {% for version in removed %}
                <li>Removed: {{ version.title }} (version {{ version.number }}){{ attribute(version, owner).deleted ? ' (deleted)' }}</li>
            {% endfor %}
            {% for change in changed %}
                <li>Changed: {{ change.to.title }} from version {{ change.from.number }} to version {{ change.to.number }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{# "from → to (±delta)"; a missing side shows as – and has no delta. #}
{% macro change(from, to, decimals) %}
    {%- if null is same as from or null is same as to -%}
        {{ from is null ? '–' : from|number_format(decimals) }} → {{ to is null ? '–' : to|number_format(decimals) }}
    {%- else -%}
        {% set delta = (to|round(decimals) - from|round(decimals))|round(decimals) -%}
        {{ from|number_format(decimals) }} → {{ to|number_format(decimals) }} ({{ 0 == delta ? '±0' : (0 < delta ? '+' : '') ~ delta|number_format(decimals) }})
    {%- endif -%}
{% endmacro %}

{% block title %}Compare versions of {{ run.title }}{% endblock %}

{% block heading %}Compare versions of run {{ run.title }}{% endblock %}

{% block content %}
    {{ include('_back_link.html.twig', {href: path('app_run_show', {uuid: run.uuid}), label: 'Back to run'}) }}

    {% if 2 > run.versions|length %}
        <p>At least two versions are needed to compare.</p>
    {% else %}
        <form method="get" action="{{ path('app_run_compare', {uuid: run.uuid}) }}">
            {{ _self.version_select('From', 'from', run.versions, from) }}
            {{ _self.version_select('To', 'to', run.versions, to) }}
            <button type="submit">Compare</button>
        </form>

        {% if diff is null %}
            <p>Select two versions.</p>
        {% elseif diff.empty %}
            <p>No differences between version {{ from.number }} and version {{ to.number }}.</p>
        {% else %}
            <h2>Differences from version {{ from.number }} to version {{ to.number }}</h2>

            {% if diff.fields %}
                <h3>Fields</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Field</th>
                            <th>Before</th>
                            <th>After</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for name, change in diff.fields %}
                            <tr>
                                <td>{{ name }}</td>
                                <td>{{ change.from ?? '–' }}</td>
                                <td>{{ change.to ?? '–' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {% if diff.configurationsAdded or diff.configurationsRemoved %}
                <h3>LLM configurations</h3>
                <ul>
                    {% for configuration in diff.configurationsAdded %}
                        <li>Added: {{ configuration.label }}</li>
                    {% endfor %}
                    {% for configuration in diff.configurationsRemoved %}
                        <li>Removed: {{ configuration.label }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if diff.scores %}
                <h3>Scores</h3>
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Testcase</th>
                            <th scope="col">LLM configuration</th>
                            <th scope="col">Score {{ from.number }} → {{ to.number }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for score in diff.scores %}
                            <tr>
                                <th scope="row">{{ score.testcase }}</th>
                                <td>{{ score.configuration }}</td>
                                <td>{{ _self.change(score.from, score.to, 0) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <h3>Average score per LLM configuration</h3>
                <table>
                    <thead>
                        <tr>
                            <th scope="col">LLM configuration</th>
                            <th scope="col">Average {{ from.number }} → {{ to.number }} (cells scored in both)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for label, average in diff.averages %}
                            <tr>
                                <th scope="row">{{ label }}</th>
                                <td>{{ _self.change(average.from, average.to, 1) }} · {{ average.cells }} {{ 1 == average.cells ? 'cell' : 'cells' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {{ _self.changes('Skills', diff.skillsAdded, diff.skillsRemoved, diff.skillsChanged, 'skill') }}
            {{ _self.changes('Testcases', diff.testcasesAdded, diff.testcasesRemoved, diff.testcasesChanged, 'testcase') }}
        {% endif %}
    {% endif %}
{% endblock %}
