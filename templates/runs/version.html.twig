{% extends 'layout.html.twig' %}

{% block title %}Run {{ version.title }} – version {{ version.number }}{% endblock %}

{% block heading %}{{ version.title }} – version {{ version.number }}{% endblock %}

{% block content %}
    {{ include('_back_link.html.twig', {href: path('app_run_show', {uuid: run.uuid}), label: 'Back to run'}) }}

    <p>Created: {{ version.createdAt|date }}</p>

    <h2>Results</h2>
    <p role="status" class="visually-hidden" data-run-progress-status></p>
    <p class="help-text" data-run-progress-notice hidden></p>
    <div id="{{ prepare_component('run-progress') }}" data-progress-url="{{ path('app_run_version_progress', {uuid: run.uuid, number: version.number}) }}" data-status="{{ version.status.value }}">
        {{ include('runs/_result_matrix.html.twig') }}
    </div>

    <h2>Description</h2>
    <p>{{ version.description ?? 'No description.' }}</p>

    <h2>LLM configurations</h2>
    <ul>
        {% for configuration in version.configurations %}
            <li>{{ configuration.label }}</li>
        {% else %}
            <li>None.</li>
        {% endfor %}
    </ul>

    <h2>Skills</h2>
    <ul>
        {% for skillVersion in version.skillVersions %}
            <li>{{ skillVersion.title }} (version {{ skillVersion.number }}){{ skillVersion.skill.deleted ? ' (deleted)' }}</li>
        {% else %}
            <li>None.</li>
        {% endfor %}
    </ul>

    <h2>Testcases</h2>
    <ul>
        {% for testcaseVersion in version.testcaseVersions %}
            <li>{{ testcaseVersion.title }} (version {{ testcaseVersion.number }}){{ testcaseVersion.testcase.deleted ? ' (deleted)' }}</li>
        {% else %}
            <li>None.</li>
        {% endfor %}
    </ul>
{% endblock %}
