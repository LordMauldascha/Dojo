{% extends 'delete.html.twig' %}

{% set action = path('app_run_delete', {uuid: run.uuid}) %}
{% set tokenId = 'delete-run-' ~ run.uuid %}
{% set cancelUrl = path('app_run_show', {uuid: run.uuid}) %}

{% block title %}Delete run{% endblock %}

{% block heading %}Delete run {{ run.title }}{% endblock %}

{% block message %}
    <p>The run and its {{ run.versions|length }} version(s) are deleted for good. Skills and testcases are kept.</p>
{% endblock %}
