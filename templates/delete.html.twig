{# Confirmation page for deleting something. A child sets action, tokenId, cancelUrl (and optionally label) and fills "message". #}
{% extends 'layout.html.twig' %}

{% import '_forms.html.twig' as forms %}

{% block content %}
    {% block message %}{% endblock %}

    {{ forms.post(action, tokenId, label|default('Delete permanently'), 'button-danger') }}
    <p><a href="{{ cancelUrl }}">Cancel</a></p>
{% endblock %}
