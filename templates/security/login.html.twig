{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
    <main class="login" id="content">
        <div class="login-panel">
            <p class="brand">Dojo<span class="brand-mark" aria-hidden="true"></span></p>
            <h1>Login</h1>

            {{ include('_flashes.html.twig') }}

            {% if error %}
                <p class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}

            <form method="post">
                <label for="username">Username</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>

                <label for="password">Password</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="button-primary">Sign in</button>
            </form>
        </div>
    </main>
{% endblock %}
